ROUTING_CONTACT_EMAIL=
# Low-traffic pedestrian prototype only; not an unlimited production API.
ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot/

# Vercel: shared timetable cache and global routing limits (server-side only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional canonical HTTPS origin. Falls back to Vercel system URL.
APP_ORIGIN=

# Optional privacy URL for a self-hosted/custom OSRM pedestrian service.
ROUTING_PRIVACY_URL=

# Server-only ODPT Challenge 2026 token. Never use a VITE_ prefix.
# Windows local development can use scripts/odpt-token.ps1 (DPAPI encrypted) instead.
ODPT_CHALLENGE_TOKEN=
